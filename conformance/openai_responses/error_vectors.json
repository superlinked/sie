      "headers": {"retry-after": "60", "x-sie-error-code": "PROVISIONING"},
      "body": {
        "error": {
          "message": "Capacity for model 'm' is starting. Retry after the number of seconds in Retry-After.",
          "type": "server_error",
          "param": null,
          "code": "provisioning"
        }
      },
      "expect": {
        "status": 503,
        "headers": {"retry-after": "60", "x-sie-error-code": "PROVISIONING"},
