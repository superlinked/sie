{
  "registered_utc": "2026-09-15",
  "note": "Pre-registration for the /ocr two-stage page. Committed before any model call. Documents, schemas, expected values, scoring rules and predictions are fixed here; nothing in this file changes after the first call. The document set is closed at 6 documents and 7 stage-2 calls per stage-2 model.",
  "stage1": {
    "role": "page pixels to Markdown",
    "model": "lightonai/LightOnOCR-2-1B",
    "endpoint": "https://api.superlinked.com",
    "path": "/v1/extract/lightonai__LightOnOCR-2-1B",
    "body_shape": "{\"items\": [{\"images\": [{\"data\": \"<base64>\", \"format\": \"<png|jpeg>\"}]}]}",
    "read_result_at": "entities[0].text",
    "note": "Byte-identical in shape to the snippet packages/tasks/src/codegen.ts generates for the ocr task with the quality model. Replaces the earlier Modal run in lightonocr-run.json so both stages of the page run against the same production API."
  },
  "stage2": {
    "role": "Markdown to typed fields under a fixed JSON schema",
    "input": "stage 1's recorded Markdown, verbatim. The page image is never sent to stage 2.",
    "models": {
      "primary": "Qwen/Qwen3.8-27B-FP8",
      "secondary": "Qwen/Qwen3.5-4B"
    },
    "endpoint": "https://api.superlinked.com",
    "path": "/v1/chat/completions",
    "temperature": 0,
    "max_tokens": 2048,
    "response_format_shape": "{\"type\": \"json_schema\", \"json_schema\": {\"name\": \"<schema id>\", \"strict\": true, \"schema\": <schema>}}",
    "instruction_template": "Fill the schema from this OCR text of a {document_type}. Use only what the text states. Use null when the text does not state a value.\n\n---\n{markdown}",
    "note": "Chat completions rather than /v1/generate because this is a text-only prompt on a Qwen model; sie-internal#4370 covers /v1/generate skipping the chat template for plain text. Both stage-2 models get byte-identical messages and schemas."
  },
  "scoring": {
    "note": "evaluate.py assigns every registered field exactly one verdict. No verdict is hand-authored. The stage-1 test asks whether the field's registered `printed` token survives into stage 1's Markdown; that is what separates an error stage 2 inherited from one stage 2 made on text it could read.",
    "normalization": "Unicode NFKC, collapse runs of whitespace to one space, trim. Applied to both the returned value and the registered expectation before comparison, and to the Markdown before the token search.",
    "verdicts": {
      "match": "returned value satisfies the field's rule",
      "stage1_lost": "printed token absent from stage 1's Markdown AND stage 2 returned null",
      "stage1_error": "printed token absent or garbled in stage 1's Markdown AND stage 2 returned a wrong non-null value",
      "stage2_error": "printed token present verbatim in stage 1's Markdown AND stage 2 returned a wrong non-null value",
      "stage2_dropped": "printed token present verbatim in stage 1's Markdown AND stage 2 returned null"
    },
    "rules": {
      "verbatim": "normalized returned string equals expect",
      "integer": "returned value is an integer equal to expect",
      "signed_parenthesis": "returned integer equals expect; the page prints the magnitude in parentheses, so stage 2 has to supply the sign",
      "strip_footnote_marker": "normalized returned string equals expect; the page prints a trailing footnote marker stage 2 has to drop",
      "gs1_element_string": "normalized returned string equals expect; ground truth is the GS1 application identifier printed under the barcode, not a reading of the human-readable date",
      "any_of": "normalized returned string is one of expect",
      "contains": "lowercased returned string contains lowercased expect",
      "absent": "expect is null because the value is not legible on the source page"
    },
    "also_recorded": [
      "schema validity of every stage-2 reply, checked against the registered schema (required keys, types, enum members)",
      "stage-1 token recall per document: how many registered printed tokens appear in the Markdown",
      "HTTP status, latency, finish reason and token counts per call"
    ]
  },
  "predictions": {
    "note": "Written before any call, published beside the outcome in SOURCES.md whether or not they hold. A prediction that misses is reported as a miss.",
    "items": [
      "At least one of NVIDIA's parenthesised rows comes back with the wrong sign, scored stage2_error.",
      "NVIDIA's `Taiwan (2)` carries its footnote marker into the location field, scored stage2_error.",
      "The label's best_before comes back 2023-12-02, a US reading of 12/02/2024, against the barcode's 2024-02-12.",
      "Stage 1 loses the blurred receipt header, and stage 2 invents a merchant name or a transaction date rather than returning null.",
      "Across the whole registered set, most fields match."
    ]
  },
  "display": {
    "note": "Three documents are displayed, chosen before the run to differ in kind. Every registered document is counted in the page's totals whatever it does; none is dropped for looking bad.",
    "documents": [
      "nvidia-annual-report-p78",
      "receipt-cord-0007",
      "product-gs1-128-label"
    ]
  },
