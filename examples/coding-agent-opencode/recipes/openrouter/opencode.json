{
  "$schema": "https://opencode.ai/config.json",
  "model": "sie-local/zai-org/GLM-5.3-Flash",
  "provider": {
    "sie-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SIE on this machine",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "local",
        "timeout": 1800000,
        "headerTimeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash via OpenRouter",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "tool_call": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "include_reasoning": true
          }
        }
      }
    }
  }
}
