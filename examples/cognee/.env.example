# SIE Serverless: create a key in https://console.superlinked.com
SIE_BASE_URL=https://api.superlinked.com
SIE_API_KEY=

# Optional independent endpoints/keys. Each role defaults to SIE_BASE_URL.
# Keys inherit SIE_API_KEY only when the endpoint has the same origin.
# For unauthenticated local endpoints, leave the corresponding key empty.
# SIE_LLM_BASE_URL=http://localhost:8081
# SIE_LLM_API_KEY=
# SIE_EMBEDDING_BASE_URL=http://localhost:8080
# SIE_EMBEDDING_API_KEY=
# SIE_RERANK_BASE_URL=http://localhost:8080
# SIE_RERANK_API_KEY=
# SIE_OCR_BASE_URL=http://localhost:8082
# SIE_OCR_API_KEY=
# SIE_DECISION_BASE_URL=http://localhost:8083
# SIE_DECISION_API_KEY=

# Optional model overrides; otherwise config.toml supplies each model.
# SIE_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
# SIE_EMBEDDING_MODEL=BAAI/bge-m3
# SIE_EMBEDDING_DIMENSIONS=1024
# SIE_OCR_MODEL=lightonai/LightOnOCR-2-1B
# SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# SIE_DECISION_MODEL=fastino/GLiNER2.5-Decide

# Change namespace before changing embedding model/dimensions or scenario.
SIE_COGNEE_NAMESPACE=example-v1
