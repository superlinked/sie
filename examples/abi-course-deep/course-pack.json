        "committed qrels and NDCG/Recall evaluator",
        "reranking is a single controlled subsystem change",
        "bounded path removes Turbopuffer and dataset-download dependencies"
      ],
      "sample": {
        "kind": "synthetic_retrieval_qrels",
        "path": "fixtures/retrieval-course.json",
        "run": "uv run python scripts/course_ablation.py",
        "max_corpus_items": 12,
        "max_run_items": 6,
        "max_candidates_per_query": 4
