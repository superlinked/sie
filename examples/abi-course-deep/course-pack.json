      "id": "contract-review",
      "source": "../contract-review-agent",
      "selection": "required_principal_example",
      "sample": {
        "kind": "synthetic_contracts",
        "prepare": "uv run make-sample",
        "run": "uv run review --contract acme-msa",
        "max_corpus_items": 3,
        "max_run_items": 1,
        "source_sha256": "b2292b21b9e9b55c0ca7b5bfbd1f255f988883d73e7d1d232017848c97dfa7eb"
      },
      "what_to_change": [
        "one role-to-model mapping",
        "search.top_k_candidates",
        "search.top_k_results"
      ],
      "what_to_measure": [
        "expected_fact_recall",
        "unsupported_fact_count",
        "stage_cold_latency_ms",
        "stage_warm_latency_ms",
        "request_ids",
        "usage",
        "settled_credits"
      ],
      "expected_output": {
        "required_top_level": ["review", "stage_ledger", "measurement"],
        "required_review_fields": [
          "document_type",
          "parties",
          "effective_date",
          "renewal_terms",
          "governing_law",
          "executed",
          "key_obligations",
          "risk_flags",
          "recommendation"
        ]
      },
