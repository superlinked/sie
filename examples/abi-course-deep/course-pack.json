          {"role": "guard", "model_id": null, "revision": null},
          {"role": "ocr", "model_id": null, "revision": null},
          {"role": "embed", "model_id": null, "revision": null},
          {"role": "rerank", "model_id": null, "revision": null},
          {"role": "entities", "model_id": null, "revision": null}
