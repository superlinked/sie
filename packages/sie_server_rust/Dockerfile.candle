# syntax=docker/dockerfile:1
#
# SIE Rust Candle Worker Image (CUDA)
#
# Build from repo root:
#   docker build -f packages/sie_server_rust/Dockerfile.candle -t sie-server-rust:latest .
#
# This is the production Candle worker image. It builds sie-server-rust with
# Candle CUDA kernels linked into the Rust binary and runs the IPC worker used
# by the sidecar for engine=candle pools.

ARG CUDA_VERSION=12.4.1
ARG RUST_VERSION=1.97.0
# Candle CUDA kernels cannot detect compute capability during Docker builds.
# Local builds default to the currently supported L4 target, and releases publish
# sie-server-rust:<version>-cuda12-sm89. Override for ad-hoc target GPUs when
# needed, e.g. A100=80, H100=90.
ARG CUDA_COMPUTE_CAP=89

FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu22.04 AS chef

ARG CUDA_COMPUTE_CAP
ARG CUDAFORGE_THREADS=2
ARG CARGO_BUILD_JOBS=2
# A cold candle-flash-attn build compiles many large CUDA translation units.
# Bound both its inner nvcc pool and Cargo's outer job pool so 16 GiB builders
# do not nondeterministically OOM. Operators can still override either arg.
ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} \
    CUDAFORGE_THREADS=${CUDAFORGE_THREADS} \
    RUSTUP_HOME=/usr/local/rustup \
    CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP} \
    PATH=/usr/local/cargo/bin:$PATH

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libssl-dev \
        pkg-config

ARG RUST_VERSION
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && cargo install cargo-chef --locked --version 0.1.77

WORKDIR /build

FROM chef AS planner
COPY packages/sie_server_rust/Cargo.toml packages/sie_server_rust/Cargo.lock ./
COPY packages/sie_server_rust/vendor/ vendor/
COPY packages/sie_telemetry/ /sie_telemetry/
COPY packages/sie_server_rust/src/ src/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
COPY packages/sie_server_rust/vendor/ vendor/
COPY packages/sie_telemetry/ /sie_telemetry/
RUN --mount=type=cache,id=sie-server-rust-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=sie-server-rust-target-${CUDA_COMPUTE_CAP},target=/build/target,sharing=locked \
    cargo chef cook --release --features cuda --recipe-path recipe.json

COPY packages/sie_server_rust/Cargo.toml packages/sie_server_rust/Cargo.lock ./
COPY packages/sie_server_rust/vendor/ vendor/
COPY packages/sie_telemetry/ /sie_telemetry/
COPY packages/sie_server_rust/src/ src/

RUN --mount=type=cache,id=sie-server-rust-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=sie-server-rust-target-${CUDA_COMPUTE_CAP},target=/build/target,sharing=locked \
    cargo build --locked --release --features cuda --bin sie-server-rust \
    && ls -lh target/release/sie-server-rust \
    && test "$(wc -c < target/release/sie-server-rust)" -gt 1000000 \
    && cp target/release/sie-server-rust /usr/local/bin/sie-server-rust

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04 AS runtime

ARG CUDA_COMPUTE_CAP

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
    && groupadd -g 1000 sie \
    && useradd -u 1000 -g sie -m sie

COPY --from=builder /usr/local/bin/sie-server-rust /sie-server-rust

ENV CUDA_HOME=/usr/local/cuda \
    CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    SIE_IPC_SOCKET_PATH=/var/run/sie/ipc.sock \
    SIE_BUNDLE=candle \
    SIE_SERVER_HOST=0.0.0.0 \
    SIE_SERVER_PORT=8080 \
    RUST_LOG=info

EXPOSE 8080

USER sie:sie
ENTRYPOINT ["/sie-server-rust"]

LABEL org.opencontainers.image.title="sie-server-rust" \
      org.opencontainers.image.description="SIE Rust worker process backed by native Candle CUDA inference." \
      org.opencontainers.image.source="https://github.com/superlinked/sie"
